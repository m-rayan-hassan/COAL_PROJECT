	   41 43 41 42 44
				
				; ============================================================
				;                      CODE SECTION
				; ============================================================
 00000000			.code
				
				; ============================================================
				;  main - Entry point of the program
				;  Purpose: Initializes RNG, gets user name, runs main loop
				; ============================================================
 00000000			main PROC
				
 00000000  E8 00000000 E	    call Randomize              ; Seed the random number generator
 00000005  E8 00000058		    call ClearScreen            ; Clear the console
 0000000A  E8 00000059		    call GetUserName            ; Ask for and store player name
				
 0000000F			mainMenuLoop:
 0000000F  E8 000000D7		    call MainMenu               ; Display menu, returns choice in EAX
				
 00000014  83 F8 01		    cmp  eax, 1                 ; Option 1: Start Quiz
 00000017  74 11		    je   doStartQuiz
 00000019  83 F8 02		    cmp  eax, 2                 ; Option 2: Instructions
 0000001C  74 31		    je   doInstructions
 0000001E  83 F8 03		    cmp  eax, 3                 ; Option 3: About
 00000021  74 33		    je   doAbout
 00000023  83 F8 04		    cmp  eax, 4                 ; Option 4: Exit
 00000026  74 35		    je   doExit
 00000028  EB E5		    jmp  mainMenuLoop           ; Invalid (shouldn't happen), loop back
				
 0000002A			doStartQuiz:
 0000002A  E8 00000194		    call SelectCategory         ; Let user pick a category
 0000002F  E8 00000295		    call SelectDifficulty       ; Let user pick difficulty level
 00000034  E8 00000396		    call StartQuiz              ; Run the quiz
 00000039  E8 000006FA		    call ShowResult             ; Display results and grade
 0000003E  E8 00000A95		    call ReplayMenu             ; Ask what to do next (returns in EAX)
				
 00000043  83 F8 01		    cmp  eax, 1                 ; 1 = Play Again
 00000046  74 E2		    je   doStartQuiz
 00000048  83 F8 03		    cmp  eax, 3                 ; 3 = Exit
 0000004B  74 10		    je   doExit
 0000004D  EB C0		    jmp  mainMenuLoop           ; 2 = Main Menu (default)
				
 0000004F			doInstructions:
 0000004F  E8 000008D4		    call ShowInstructions       ; Display instructions screen
 00000054  EB B9		    jmp  mainMenuLoop           ; Return to main menu
				
 00000056			doAbout:
 00000056  E8 000009C3		    call ShowAbout              ; Display about screen
 0000005B  EB B2		    jmp  mainMenuLoop           ; Return to main menu
				
 0000005D			doExit:
 0000005D  E8 00000B3A		    call ExitProgram            ; Display goodbye and exit
				
 00000062			main ENDP
				
				; ============================================================
				;  ClearScreen - Clears the console screen
				;  Purpose: Wrapper around Irvine32's Clrscr
				; ============================================================
 00000062			ClearScreen PROC
 00000062  E8 00000000 E	    call Clrscr
 00000067  C3			    ret
 00000068			ClearScreen ENDP
				
				; ============================================================
				;  GetUserName - Asks for and stores the player's name
				;  Purpose: Displays welcome screen and reads name input
				;  Output:  userName buffer is filled with the player's name
				; ============================================================
 00000068			GetUserName PROC
				
				    ; --- Display Welcome Banner ---
 00000068  B8 0000000E		    mov  eax, CLR_YELLOW
 0000006D  E8 00000000 E	    call SetTextColor
				
 00000072  BA 0000016F R	    mov  edx, OFFSET welc1         ; Top border
 00000077  E8 00000000 E	    call WriteString
 0000007C  E8 00000000 E	    call Crlf
 00000081  BA 000001A0 R	    mov  edx, OFFSET welc2         ; Blank line
 00000086  E8 00000000 E	    call WriteString
 0000008B  E8 00000000 E	    call Crlf
 00000090  BA 000001D1 R	    mov  edx, OFFSET welc3         ; Title text
 00000095  E8 00000000 E	    call WriteString
 0000009A  E8 00000000 E	    call Crlf
 0000009F  BA 00000201 R	    mov  edx, OFFSET welc4         ; Version
 000000A4  E8 00000000 E	    call WriteString
 000000A9  E8 00000000 E	    call Crlf
 000000AE  BA 00000232 R	    mov  edx, OFFSET welc5         ; Bottom border
 000000B3  E8 00000000 E	    call WriteString
 000000B8  E8 00000000 E	    call Crlf
 000000BD  E8 00000000 E	    call Crlf
				
				    ; --- Prompt for Name ---
 000000C2  B8 0000000F		    mov  eax, CLR_WHITE
 000000C7  E8 00000000 E	    call SetTextColor
 000000CC  BA 00000089 R	    mov  edx, OFFSET promptName    ; "Enter your name: "
 000000D1  E8 00000000 E	    call WriteString
				
				    ; Read the name string into userName buffer
 000000D6  BA 00000000 R	    mov  edx, OFFSET userName
 000000DB  B9 00000020		    mov  ecx, MAX_NAME             ; Max characters to read
 000000E0  E8 00000000 E	    call ReadString                ; Reads until Enter is pressed
				
 000000E5  E8 00000000 E	    call Crlf
 000000EA  C3			    ret
				
 000000EB			GetUserName ENDP
				
				; ============================================================
				;  MainMenu - Displays the main menu and gets user choice
				;  Purpose: Shows 4 options and validates input
				;  Output:  EAX = user choice (1, 2, 3, or 4)
				; ============================================================
 000000EB			MainMenu PROC
				
 000000EB  E8 FFFFFF72		    call ClearScreen
				
				    ; --- Display Menu Header ---
 000000F0  B8 0000000E		    mov  eax, CLR_YELLOW
 000000F5  E8 00000000 E	    call SetTextColor
 000000FA  BA 00000058 R	    mov  edx, OFFSET separator
 000000FF  E8 00000000 E	    call WriteString
 00000104  E8 00000000 E	    call Crlf
 00000109  BA 00000263 R	    mov  edx, OFFSET menuTitle     ; "MAIN MENU"
 0000010E  E8 00000000 E	    call WriteString
 00000113  E8 00000000 E	    call Crlf
 00000118  BA 00000058 R	    mov  edx, OFFSET separator
 0000011D  E8 00000000 E	    call WriteString
 00000122  E8 00000000 E	    call Crlf
 00000127  E8 00000000 E	    call Crlf
				
				    ; --- Display Menu Options ---
 0000012C  B8 0000000F		    mov  eax, CLR_WHITE
 00000131  E8 00000000 E	    call SetTextColor
				
 00000136  BA 0000027C R	    mov  edx, OFFSET menuOpt1     ; "1. Start Quiz"
 0000013B  E8 00000000 E	    call WriteString
 00000140  E8 00000000 E	    call Crlf
 00000145  BA 0000028C R	    mov  edx, OFFSET menuOpt2     ; "2. Instructions"
 0000014A  E8 00000000 E	    call WriteString
 0000014F  E8 00000000 E	    call Crlf
 00000154  BA 0000029E R	    mov  edx, OFFSET menuOpt3     ; "3. About Project"
 00000159  E8 00000000 E	    call WriteString
 0000015E  E8 00000000 E	    call Crlf
 00000163  BA 000002B1 R	    mov  edx, OFFSET menuOpt4     ; "4. Exit"
 00000168  E8 00000000 E	    call WriteString
 0000016D  E8 00000000 E	    call Crlf
 00000172  E8 00000000 E	    call Crlf
				
				    ; --- Get and Validate Input ---
 00000177			menuInput:
 00000177  BA 0000009D R	    mov  edx, OFFSET choicePrompt  ; "Enter your choice: "
 0000017C  E8 00000000 E	    call WriteString
 00000181  E8 00000000 E	    call ReadChar                  ; Read single character into AL
 00000186  E8 00000000 E	    call WriteChar                 ; Echo the character
 0000018B  E8 00000000 E	    call Crlf
				
				    ; Validate: must be '1', '2', '3', or '4'
 00000190  3C 31		    cmp  al, '1'
 00000192  72 0A		    jb   menuInvalid
 00000194  3C 34		    cmp  al, '4'
 00000196  77 06		    ja   menuInvalid
				
				    ; Convert ASCII to number and return in EAX
 00000198  2C 30		    sub  al, '0'                   ; '1'->1, '2'->2, etc.
 0000019A  0F B6 C0		    movzx eax, al                  ; Zero-extend to 32 bits
 0000019D  C3			    ret
				
 0000019E			menuInvalid:
				    ; Show error message in red
 0000019E  B8 0000000C		    mov  eax, CLR_RED
 000001A3  E8 00000000 E	    call SetTextColor
 000001A8  BA 000000CD R	    mov  edx, OFFSET invalidMsg
 000001AD  E8 00000000 E	    call WriteString
 000001B2  E8 00000000 E	    call Crlf
 000001B7  B8 0000000F		    mov  eax, CLR_WHITE
 000001BC  E8 00000000 E	    call SetTextColor
 000001C1  EB B4		    jmp  menuInput                 ; Ask again
				
 000001C3			MainMenu ENDP
				
				; ============================================================
