				; ============================================================
				;                   CORRECT ANSWERS ARRAY
				; ============================================================
				; Stores the correct answer letter for each of the 30 questions.
				; Index  0- 9 = CS answers
				; Index 10-19 = Math answers
				; Index 20-29 = GK answers
				; ============================================================
 000015B5 42 41 44 43 42	answers BYTE 'B','A','D','C','B','A','C','A','B','D'     ; CS
	   41 43 41 42 44
 000015BF  42 43 41 44 42	        BYTE 'B','C','A','D','B','A','C','B','A','D'     ; Math
	   41 43 42 41 44
