 000001DC  E8 00000000 E	    call Crlf
 000001E1  BA 000002BB R	    mov  edx, OFFSET catTitle      ; "SELECT CATEGORY"
 000001E6  E8 00000000 E	    call WriteString
 000001EB  E8 00000000 E	    call Crlf
 000001F0  BA 00000058 R	    mov  edx, OFFSET separator
 000001F5  E8 00000000 E	    call WriteString
 000001FA  E8 00000000 E	    call Crlf
 000001FF  E8 00000000 E	    call Crlf
				
				    ; --- Display Options ---
 00000204  B8 0000000F		    mov  eax, CLR_WHITE
 00000209  E8 00000000 E	    call SetTextColor
				
 0000020E  BA 000002D7 R	    mov  edx, OFFSET catOpt1      ; "1. Computer Science"
 00000213  E8 00000000 E	    call WriteString
 00000218  E8 00000000 E	    call Crlf
 0000021D  BA 000002ED R	    mov  edx, OFFSET catOpt2      ; "2. Mathematics"
 00000222  E8 00000000 E	    call WriteString
 00000227  E8 00000000 E	    call Crlf
