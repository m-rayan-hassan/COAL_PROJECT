 00000231  E8 00000000 E	    call WriteString
 00000236  E8 00000000 E	    call Crlf
 0000023B  E8 00000000 E	    call Crlf
				
				    ; --- Get and Validate Input ---
 00000240			catInput:
 00000240  BA 0000009D R	    mov  edx, OFFSET choicePrompt
 00000245  E8 00000000 E	    call WriteString
 0000024A  E8 00000000 E	    call ReadChar
 0000024F  E8 00000000 E	    call WriteChar
 00000254  E8 00000000 E	    call Crlf
				
 00000259  3C 31		    cmp  al, '1'
 0000025B  74 2D		    je   catCS
 0000025D  3C 32		    cmp  al, '2'
 0000025F  74 3E		    je   catMath
 00000261  3C 33		    cmp  al, '3'
 00000263  74 4F		    je   catGK
				
				    ; Invalid input
 00000265  B8 0000000C		    mov  eax, CLR_RED
 0000026A  E8 00000000 E	    call SetTextColor
 0000026F  BA 000000CD R	    mov  edx, OFFSET invalidMsg
 00000274  E8 00000000 E	    call WriteString
 00000279  E8 00000000 E	    call Crlf
 0000027E  B8 0000000F		    mov  eax, CLR_WHITE
 00000283  E8 00000000 E	    call SetTextColor
 00000288  EB B6		    jmp  catInput
				
 0000028A			catCS:
 0000028A  C7 05 00000038 R	    mov  catChoice, 1
	   00000001
 00000294  C7 05 00000034 R	    mov  categoryBase, 0           ; CS starts at index 0
	   00000000
 0000029E  C3			    ret
				
 0000029F			catMath:
 0000029F  C7 05 00000038 R	    mov  catChoice, 2
	   00000002
 000002A9  C7 05 00000034 R	    mov  categoryBase, 10          ; Math starts at index 10
	   0000000A
 000002B3  C3			    ret
				
 000002B4			catGK:
 000002B4  C7 05 00000038 R	    mov  catChoice, 3
	   00000003
 000002BE  C7 05 00000034 R	    mov  categoryBase, 20          ; GK starts at index 20
	   00000014
 000002C8  C3			    ret
				
 000002C9			SelectCategory ENDP
				
